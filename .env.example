# Connection string do Neon (Vercel > Storage, ou console.neon.tech). Use a "pooled".
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require
# Senha para entrar no app
APP_PASSWORD=troque-esta-senha
# Segredo para assinar o cookie de sessão (gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))")
AUTH_SECRET=
